    "test:user-activity-rules": "firebase emulators:exec --project smss-v46-activity-test --only firestore \"node scripts/test-user-activity-rules.mjs\"",
    "test:v46-delete-controls": "node scripts/test-v46-delete-controls.mjs",
    "test:v47:terms": "node v47/test-term-catalog.mjs",
    "test:v47:term-rules": "node v47/test-term-rules-parity.mjs",
    "test:v47:large-class-plan": "node v47/test-large-class-mark-plan.mjs"
