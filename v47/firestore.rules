rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function loggedIn() { return request.auth != null; }
    function superAdmin() {
      return loggedIn()
        && exists(/databases/$(database)/documents/v47_super_admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/v47_super_admins/$(request.auth.uid)).data.get('active', false) == true;
    }
    function schoolPath(sid) { return /databases/$(database)/documents/schools/$(sid); }
    function memberPath(sid) { return /databases/$(database)/documents/schools/$(sid)/members/$(request.auth.uid); }
    function activeSchool(sid) {
      return exists(schoolPath(sid)) && get(schoolPath(sid)).data.get('active', false) == true;
    }
    function activeMember(sid) {
      return loggedIn() && activeSchool(sid) && exists(memberPath(sid))
        && get(memberPath(sid)).data.get('active', false) == true
        && get(memberPath(sid)).data.get('uid', '') == request.auth.uid
        && get(memberPath(sid)).data.get('schoolId', '') == sid
        && get(memberPath(sid)).data.get('role', '') in ['school_admin', 'teacher', 'viewer'];
    }
    function memberRole(sid, role) {
      return activeMember(sid) && get(memberPath(sid)).data.get('role', '') == role;
    }
    function canRead(sid) { return superAdmin() || activeMember(sid); }
    function canAdmin(sid) { return superAdmin() || memberRole(sid, 'school_admin'); }
    function validSchool(sid) {
      return sid.matches('^[A-Za-z0-9_-]{3,64}$')
        && request.resource.data.keys().hasOnly(['id', 'name', 'iemisCode', 'active'])
        && request.resource.data.keys().hasAll(['id', 'name', 'active'])
        && request.resource.data.id == sid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 160
        && request.resource.data.get('iemisCode', '') is string
        && (request.resource.data.get('iemisCode', '') == ''
            || request.resource.data.get('iemisCode', '').matches('^[0-9]{5,20}$'))
        && request.resource.data.active == false;
    }
    match /v47_super_admins/{uid} { allow read, write: if false; }
    match /schools/{sid} {
      allow get: if canRead(sid);
      allow list: if superAdmin();
      allow create: if superAdmin() && validSchool(sid);
      allow update: if superAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active'])
        && request.resource.data.active is bool;
      allow delete: if false;
      match /members/{uid} {
        function validMember() {
          return request.resource.data.keys().hasOnly(['uid', 'schoolId', 'role', 'active'])
            && request.resource.data.keys().hasAll(['uid', 'schoolId', 'role', 'active'])
            && request.resource.data.uid == uid
            && request.resource.data.schoolId == sid
            && request.resource.data.role in ['school_admin', 'teacher', 'viewer']
            && request.resource.data.active is bool;
        }
        allow get: if canAdmin(sid) || (loggedIn() && uid == request.auth.uid && activeMember(sid));
        allow list: if canAdmin(sid);
        allow create, update: if superAdmin() && validMember();
        allow delete: if superAdmin();
      }
      match /students/{id} {
        allow get, list: if canRead(sid);
        allow create, update: if canAdmin(sid);
        allow delete: if false;
      }
      match /marks/{id} {
        allow get, list: if canRead(sid);
        allow create, update: if canAdmin(sid);
        allow delete: if false;
      }
      match /attendance/{id} {
        allow get, list: if canRead(sid);
        allow create, update: if canAdmin(sid);
        allow delete: if false;
      }
      match /{collection}/{id} {
        allow get, list: if collection in ['staff','classes','subjects','exams','mark_settings','school_settings','subject_assignments','component_marks'] && canRead(sid);
        allow create, update: if collection in ['staff','classes','subjects','exams','mark_settings','school_settings','subject_assignments','component_marks'] && canAdmin(sid);
        allow delete: if false;
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
