rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn() { return request.auth != null; }
  function superAdmin() { return signedIn() && exists(/databases/$(database)/documents/v47_super_admins/$(request.auth.uid)) && get(/databases/$(database)/documents/v47_super_admins/$(request.auth.uid)).data.active == true; }
  function membershipPath(schoolId) { return /databases/$(database)/documents/schools/$(schoolId)/members/$(request.auth.uid); }
  function schoolActive(schoolId) { return exists(/databases/$(database)/documents/schools/$(schoolId)) && get(/databases/$(database)/documents/schools/$(schoolId)).data.active == true; }
  function member(schoolId) { return signedIn() && schoolActive(schoolId) && exists(membershipPath(schoolId)) && get(membershipPath(schoolId)).data.active == true; }
  function memberRole(schoolId, role) { return member(schoolId) && get(membershipPath(schoolId)).data.role == role; }
  function reader(schoolId) { return superAdmin() || member(schoolId); }
  function schoolAdmin(schoolId) { return superAdmin() || memberRole(schoolId, 'school_admin'); }
  match /v47_super_admins/{uid} { allow read, write: if false; }
  match /schools/{schoolId} {
   allow get, list: if reader(schoolId);
   allow create, update: if superAdmin() && request.resource.data.get('active', false) is bool;
   allow delete: if false; // prevent accidental orphaning of school subcollections
   match /members/{uid} {
    allow get, list: if schoolAdmin(schoolId) || (signedIn() && request.auth.uid == uid && member(schoolId));
    allow create: if schoolAdmin(schoolId) && (superAdmin() || request.resource.data.get('role','') in ['teacher','viewer']) && request.resource.data.get('role','') in ['school_admin','teacher','viewer'] && request.resource.data.get('active',false) is bool && request.resource.data.get('schoolId','') == schoolId && request.resource.data.get('uid','') == uid;
    allow update: if schoolAdmin(schoolId) && (superAdmin() || (resource.data.get('role','') in ['teacher','viewer'] && request.resource.data.get('role','') in ['teacher','viewer'])) && request.resource.data.get('role','') in ['school_admin','teacher','viewer'] && request.resource.data.get('active',false) is bool && request.resource.data.get('schoolId','') == schoolId && request.resource.data.get('uid','') == uid;
    allow delete: if schoolAdmin(schoolId) && (superAdmin() || resource.data.get('role','') in ['teacher','viewer']);
   }
   match /{collection}/{docId} {
    allow get, list: if collection in ['students','staff','classes','subjects','exams','marks','attendance','mark_settings','user_roles'] && reader(schoolId);
    allow create, update, delete: if collection in ['students','staff','classes','subjects','exams','marks','attendance','mark_settings','user_roles'] && schoolAdmin(schoolId);
   }
  }
  // No legacy root collection access in the V47-only rules file.
  match /{document=**} { allow read, write: if false; }
 }
}
