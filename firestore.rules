rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function adminUid() {
      return 'K6uSLmqg0vWCtCuzwtxKzFpQMu62';
    }

    function isAdmin() {
      return signedIn() && request.auth.uid == adminUid();
    }

    function rolePath(uid) {
      return /databases/$(database)/documents/user_roles/$(uid);
    }

    function hasActiveRole() {
      return signedIn() && (
        isAdmin() ||
        (exists(rolePath(request.auth.uid)) &&
         get(rolePath(request.auth.uid)).data.active == true)
      );
    }

    function roleData() {
      return get(rolePath(request.auth.uid)).data;
    }

    function isViewer() { return hasActiveRole() && roleData().get('roles', []) is list && roleData().get('roles', []).hasAny(['viewer']); }

    function hasRole(roleName) {
      return isAdmin() ||
        (hasActiveRole() &&
         roleData().get('roles', []) is list &&
         roleData().get('roles', []).hasAny([roleName]));
    }

    function studentBelongsToClass(studentId, className) {
      let studentPath = /databases/$(database)/documents/students/$(studentId);
      let student = get(studentPath).data;
      return exists(studentPath) &&
        student.get('class', student.get('className', '')) == className &&
        student.get('active', true) != false;
    }

    function studentCanTakeSubject(studentId, subjectName) {
      let studentPath = /databases/$(database)/documents/students/$(studentId);
      let student = get(studentPath).data;
      return !subjectName.matches('^(ऐच्छिक प्रथम|ऐच्छिक द्वितीय|Optional I:|Optional II:).*') ||
        (student.get('optionalSubjects', []) is list &&
         student.get('optionalSubjects', []).hasAny([subjectName])) ||
        student.get('optionalSubject1', '') == subjectName ||
        student.get('optionalSubject2', '') == subjectName;
    }

    function teacherSubjectAccess(className, subjectName, sectionName) {
      let role = roleData();
      let roles = role.get('roles', []);
      let keys = role.get('subjectAssignmentKeys', []);
      let sections = role.get('subjectAssignmentSectionKeys', []);
      return role.get('active', false) == true && roles is list && roles.hasAny(['subject_teacher']) &&
        keys is list && keys.hasAny([className + '::' + subjectName]) &&
        (!(sections is list) || sections.size() == 0 ||
          sections.hasAny([className + '::' + subjectName + '::ALL',
            className + '::' + subjectName + '::' + sectionName]));
    }

    function isAssignedSubject(className, subjectName, sectionName) {
      return isAdmin() || (signedIn() && teacherSubjectAccess(className, subjectName, sectionName));
    }


    function isAssignedSubjectPair(className, subjectName) {
      return isAdmin() ||
        (hasRole('subject_teacher') &&
         roleData().get('subjectAssignmentKeys', []) is list &&
         roleData().get('subjectAssignmentKeys', [])
           .hasAny([className + '::' + subjectName]));
    }

    function isAssignedClassTeacher(className) {
      return isAdmin() ||
        (hasRole('class_teacher') &&
         roleData().get('classTeacherClassNames', []) is list &&
         roleData().get('classTeacherClassNames', []).hasAny([className]));
    }


    function isAssignedStudentClass(className) {
      return isAdmin() ||
        isAssignedClassTeacher(className) ||
        (hasRole('subject_teacher') &&
         roleData().get('subjectAssignmentClassNames', []) is list &&
         roleData().get('subjectAssignmentClassNames', []).hasAny([className]));
    }

    // Core school records: active school users can read; only Admin can change.
    match /students/{documentId} {
      allow get, list: if hasActiveRole() && (isViewer() || isAssignedStudentClass(resource.data.get('class', resource.data.get('className', '')));
      allow create, update, delete: if isAdmin();
    }

    match /staff/{documentId} {
      allow get, list: if isAdmin() || isViewer();
      allow create, update, delete: if isAdmin();
    }

    match /classes/{documentId} {
      allow get, list: if hasActiveRole();
      allow create, update, delete: if isAdmin();
    }

    match /subjects/{documentId} {
      allow get, list: if hasActiveRole();
      allow create, update, delete: if isAdmin();
    }

    match /exams/{documentId} {
      allow get, list: if hasActiveRole() && (isViewer() || isAssignedStudentClass(resource.data.get('className', '')));
      allow create, update, delete: if isAdmin();
    }

    match /mark_settings/{documentId} {
      allow get, list: if hasActiveRole();
      allow create, update, delete: if isAdmin();
    }

    // Retain legacy custom assessment validation separately from IEMIS templates.
    // matches and numeric bounds reject incompatible types; tested with malformed maps.
    // Use fixed-size branches to stay within the evaluation budget through six parts.
    function validMarkScore(score) {
      let name = score.name;
      let full = score.fullMarks;
      let got = score.obtained;
      return score.keys().hasOnly(['name', 'fullMarks', 'obtained']) &&
        name.matches('^[\\s\\S]{1,80}$') &&
        full >= 0 &&
        (got == null || (got >= 0 && got <= full));
    }

    function validCustomScores1(data) {
      let a = data.scores[0];
      return validMarkScore(a) &&
        data.totalFullMarks == a.fullMarks &&
        data.totalObtained == (a.obtained == null ? 0 : a.obtained) &&
        (!data.get('isAbsent', false) || (a.obtained == null));
    }

    function validCustomScores2(data) {
      let a = data.scores[0];
      let b = data.scores[1];
      return validMarkScore(a) && validMarkScore(b) &&
        data.totalFullMarks == a.fullMarks + b.fullMarks &&
        data.totalObtained == (a.obtained == null ? 0 : a.obtained) + (b.obtained == null ? 0 : b.obtained) &&
        (!data.get('isAbsent', false) || (a.obtained == null && b.obtained == null));
    }

    function validCustomScores3(data) {
      let a = data.scores[0];
      let b = data.scores[1];
      let c = data.scores[2];
      return validMarkScore(a) && validMarkScore(b) && validMarkScore(c) &&
        data.totalFullMarks == a.fullMarks + b.fullMarks + c.fullMarks &&
        data.totalObtained == (a.obtained == null ? 0 : a.obtained) + (b.obtained == null ? 0 : b.obtained) + (c.obtained == null ? 0 : c.obtained) &&
        (!data.get('isAbsent', false) || (a.obtained == null && b.obtained == null && c.obtained == null));
    }

    function validCustomScores4(data) {
      let a = data.scores[0];
      let b = data.scores[1];
      let c = data.scores[2];
      let d = data.scores[3];
      return validMarkScore(a) && validMarkScore(b) && validMarkScore(c) && validMarkScore(d) &&
        data.totalFullMarks == a.fullMarks + b.fullMarks + c.fullMarks + d.fullMarks &&
        data.totalObtained == (a.obtained == null ? 0 : a.obtained) + (b.obtained == null ? 0 : b.obtained) + (c.obtained == null ? 0 : c.obtained) + (d.obtained == null ? 0 : d.obtained) &&
        (!data.get('isAbsent', false) || (a.obtained == null && b.obtained == null && c.obtained == null && d.obtained == null));
    }

    function validCustomScores5(data) {
      let a = data.scores[0];
      let b = data.scores[1];
      let c = data.scores[2];
      let d = data.scores[3];
      let e = data.scores[4];
      return validMarkScore(a) && validMarkScore(b) && validMarkScore(c) && validMarkScore(d) && validMarkScore(e) &&
        data.totalFullMarks == a.fullMarks + b.fullMarks + c.fullMarks + d.fullMarks + e.fullMarks &&
        data.totalObtained == (a.obtained == null ? 0 : a.obtained) + (b.obtained == null ? 0 : b.obtained) + (c.obtained == null ? 0 : c.obtained) + (d.obtained == null ? 0 : d.obtained) + (e.obtained == null ? 0 : e.obtained) &&
        (!data.get('isAbsent', false) || (a.obtained == null && b.obtained == null && c.obtained == null && d.obtained == null && e.obtained == null));
    }

    function validCustomScores6(data) {
      let a = data.scores[0];
      let b = data.scores[1];
      let c = data.scores[2];
      let d = data.scores[3];
      let e = data.scores[4];
      let f = data.scores[5];
      return validMarkScore(a) && validMarkScore(b) && validMarkScore(c) && validMarkScore(d) && validMarkScore(e) && validMarkScore(f) &&
        data.totalFullMarks == a.fullMarks + b.fullMarks + c.fullMarks + d.fullMarks + e.fullMarks + f.fullMarks &&
        data.totalObtained == (a.obtained == null ? 0 : a.obtained) + (b.obtained == null ? 0 : b.obtained) + (c.obtained == null ? 0 : c.obtained) + (d.obtained == null ? 0 : d.obtained) + (e.obtained == null ? 0 : e.obtained) + (f.obtained == null ? 0 : f.obtained) &&
        (!data.get('isAbsent', false) || (a.obtained == null && b.obtained == null && c.obtained == null && d.obtained == null && e.obtained == null && f.obtained == null));
    }

    function validStandardMarkScores(data) {
      let n = data.scores.size();
      return n == 1 ? validCustomScores1(data) :
        n == 2 ? validCustomScores2(data) :
        n == 3 ? validCustomScores3(data) :
        n == 4 ? validCustomScores4(data) :
        n == 5 ? validCustomScores5(data) : validCustomScores6(data);
    }

    function validLearningAchievement(data) {
      let c = data.scores[0];
      let f = data.scores[1];
      let o = data.scores[2];
      let count = c.fullMarks;
      let absent = data.get('isAbsent', false);
      return data.scores.size() == 3 &&
        c is map && f is map && o is map &&
        c.keys().hasOnly(['name', 'fullMarks', 'obtained']) &&
        f.keys().hasOnly(['name', 'fullMarks', 'obtained']) &&
        o.keys().hasOnly(['name', 'fullMarks', 'obtained']) &&
        c.name in ['No. of Learning Achievement', 'No. Of Learning Achievement'] &&
        f.name == 'Full Marks' && o.name == 'Obtained Learning Achievement' &&
        count is int && count >= 0 && count <= 5000 && f.fullMarks == count * 4 &&
        o.fullMarks == f.fullMarks && f.obtained == null &&
        (absent ? (c.obtained == null && o.obtained == null)
          : (c.obtained == count &&
            (o.obtained == null || (o.obtained is int && o.obtained >= 0 && o.obtained <= o.fullMarks)))) &&
        data.totalFullMarks == o.fullMarks &&
        data.totalObtained == (o.obtained == null ? 0 : o.obtained);
    }

    function hasIemisMarkStructure(data) {
      let s = data.scores;
      let n = s.size();
      return n in [3, 4] && s[0].name == 'Participation' &&
        s[1].name == 'Practical/Project' &&
        s[2].name in ['First Term Examination', 'Second Term Examination',
          'Third Term Examination', 'Total of Term', 'Half-Yearly Term Examination',
          'Internal Term Examination', 'Other Term Examination'] &&
        ((s[0].fullMarks == 4 && s[1].fullMarks == 36 && s[2].fullMarks == 10) ||
         (s[0].fullMarks == 3 && s[1].fullMarks in [16, 41] && s[2].fullMarks == 6)) &&
        (n == 3 || (s[3].name == 'TH (Theory)' &&
          s[3].fullMarks == (s[0].fullMarks == 4 || s[1].fullMarks == 41 ? 50 : 75)));
    }

    function boundedMark(value, maximum) {
      return value == null || (value is number && value >= 0 && value <= maximum);
    }

    function validIemisMarkScores(data) {
      let s = data.scores;
      let n = s.size();
      let p = s[0].fullMarks;
      let project = s[1].fullMarks;
      let term = s[2].fullMarks;
      let final = n == 4 ? s[3].fullMarks : 0;
      let a = s[0].obtained;
      let b = s[1].obtained;
      let c = s[2].obtained;
      let d = n == 4 ? s[3].obtained : null;
      return boundedMark(a, p) && boundedMark(b, project) &&
        boundedMark(c, term) && boundedMark(d, final) &&
        (n == 3 ? s == [
          {'name': 'Participation', 'fullMarks': p, 'obtained': a},
          {'name': 'Practical/Project', 'fullMarks': project, 'obtained': b},
          {'name': s[2].name, 'fullMarks': term, 'obtained': c}
        ] : s == [
          {'name': 'Participation', 'fullMarks': p, 'obtained': a},
          {'name': 'Practical/Project', 'fullMarks': project, 'obtained': b},
          {'name': s[2].name, 'fullMarks': term, 'obtained': c},
          {'name': 'TH (Theory)', 'fullMarks': final, 'obtained': d}
        ]) &&
        data.totalFullMarks == p + project + term + final &&
        data.totalObtained == (a == null ? 0 : a) + (b == null ? 0 : b) +
          (c == null ? 0 : c) + (d == null ? 0 : d) &&
        (!data.get('isAbsent', false) || (a == null && b == null && c == null && d == null));
    }

    function validMarkShape(data) {
      // Every required field is accessed and type-checked below. Missing fields deny.
      return data.keys().hasOnly([
          'studentId', 'examId', 'subject', 'className', 'section',
          'scores', 'totalFullMarks', 'totalObtained', 'assessmentType',
          'academicYear', 'termKey', 'termName',
          'createdAt', 'createdBy', 'updatedAt', 'updatedBy', 'isAbsent'
        ]) &&
        data.studentId is string && data.studentId.size() > 0 && data.studentId.size() <= 150 &&
        data.examId is string && data.examId.size() > 0 && data.examId.size() <= 150 &&
        data.className is string && data.className.size() > 0 && data.className.size() <= 40 &&
        data.subject is string && data.subject.size() > 0 && data.subject.size() <= 100 &&
        data.section is string && data.section.size() <= 40 &&
        (!('isAbsent' in data) || data.isAbsent is bool) &&
        data.scores is list && data.scores.size() > 0 &&
        // Use a conditional branch so oversized lists are rejected before
        // evaluating the expensive per-component and total expressions.
        (data.scores.size() <= 6
          ? (data.totalFullMarks is number && data.totalFullMarks >= 0 &&
             data.totalObtained is number && data.totalObtained >= 0 &&
             (data.assessmentType == 'learning-achievement'
               ? validLearningAchievement(data)
               : (hasIemisMarkStructure(data) ? validIemisMarkScores(data) : validStandardMarkScores(data))) &&
             data.totalObtained <= data.totalFullMarks)
          : false) &&
        data.assessmentType in ['marks', 'learning-achievement'] &&
        data.academicYear is string &&
        data.termKey is string &&
        data.termName is string;
    }

    function markExamMatches(data) {
      let examPath = /databases/$(database)/documents/exams/$(data.examId);
      return exists(examPath) &&
        get(examPath).data.className == data.className;
    }

    // Marks are readable by active school users. Teacher writes are bound to
    // the assigned class/subject/section, enrolled student and matching exam.
    // The bounded score validator mirrors client-side range and absence checks.
    match /marks/{documentId} {
      // A teacher may confirm that a new deterministic ID is still unused.
      // Existing records and list queries remain assignment/section restricted.
      allow get: if resource == null ? (hasRole('subject_teacher') || isViewer()) :
        (isViewer() || isAssignedSubject(resource.data.className, resource.data.subject, resource.data.section));
      allow list: if isAssignedSubject(resource.data.className, resource.data.subject, resource.data.section);
      allow create: if isAdmin() ||
        (isAssignedSubject(request.resource.data.className,
                           request.resource.data.subject,
                           request.resource.data.section) &&
         validMarkShape(request.resource.data) &&
         request.resource.data.createdBy == request.auth.uid &&
         request.resource.data.createdAt == request.time &&
         !('updatedBy' in request.resource.data) &&
         studentBelongsToClass(request.resource.data.studentId,
                               request.resource.data.className) &&
         markExamMatches(request.resource.data));
      allow update: if isAdmin() ||
        (isAssignedSubject(resource.data.className, resource.data.subject,
                           resource.data.section) &&
         validMarkShape(request.resource.data) &&
         request.resource.data.updatedBy == request.auth.uid &&
         request.resource.data.updatedAt == request.time &&
         request.resource.data.createdBy == resource.data.createdBy &&
         request.resource.data.createdAt == resource.data.createdAt &&
         request.resource.data.studentId == resource.data.studentId &&
         request.resource.data.examId == resource.data.examId &&
         request.resource.data.className == resource.data.className &&
         request.resource.data.subject == resource.data.subject &&
         request.resource.data.section == resource.data.section);
      allow delete: if isAdmin();
    }

    function validDailyAttendance(data) {
      return data.keys().hasAll([
          'date', 'className', 'attendanceType', 'subject', 'students',
          'totalStudents', 'presentCount', 'absentCount', 'leaveCount',
          'academicYear', 'updatedAt', 'updatedBy'
        ]) &&
        data.keys().hasOnly([
          'date', 'className', 'attendanceType', 'subject', 'students',
          'totalStudents', 'presentCount', 'absentCount', 'leaveCount',
          'academicYear', 'updatedAt', 'updatedBy', 'createdAt', 'createdBy'
        ]) &&
        data.date is string && data.date.size() > 0 && data.date.size() <= 20 &&
        data.className is string && data.className.size() > 0 && data.className.size() <= 40 &&
        data.attendanceType == 'daily' &&
        (data.subject == null || (data.subject is string && data.subject.size() <= 100)) &&
        data.students is list && data.students.size() > 0 &&
        data.students.size() <= 200 &&
        data.totalStudents is int && data.totalStudents == data.students.size() &&
        data.presentCount is int && data.presentCount >= 0 &&
        data.absentCount is int && data.absentCount >= 0 &&
        data.leaveCount is int && data.leaveCount >= 0 &&
        data.presentCount + data.absentCount + data.leaveCount == data.totalStudents &&
        data.academicYear is string && data.academicYear.size() > 0 && data.academicYear.size() <= 20 &&
        data.updatedBy == request.auth.uid &&
        data.updatedAt == request.time;
    }

    // Class teachers can write daily attendance only for assigned classes.
    // Document identity, date, original creator and attendance type are immutable
    // to prevent moving or relabelling an existing attendance register.
    match /attendance/{documentId} {
      allow get, list: if hasActiveRole() && (isViewer() || isAssignedClassTeacher(resource.data.className));
      allow create: if isAdmin() ||
        (hasActiveRole() &&
         validDailyAttendance(request.resource.data) &&
         request.resource.data.createdBy == request.auth.uid &&
         request.resource.data.createdAt == request.time &&
         isAssignedClassTeacher(request.resource.data.className));
      allow update: if isAdmin() ||
        (hasActiveRole() &&
         validDailyAttendance(request.resource.data) &&
         resource.data.attendanceType == 'daily' &&
         request.resource.data.className == resource.data.className &&
         request.resource.data.date == resource.data.date &&
         request.resource.data.subject == resource.data.subject &&
         request.resource.data.createdBy == resource.data.createdBy &&
         request.resource.data.createdAt == resource.data.createdAt &&
         isAssignedClassTeacher(resource.data.className));
      allow delete: if isAdmin();
    }

    // Certificate records contain issued student certificate snapshots; Admin only.
    match /certificates/{certificateId} {
      allow get, list: if isAdmin() || isViewer();
      allow create: if isAdmin() &&
        request.resource.data.issuedBy == request.auth.uid &&
        request.resource.data.keys().hasOnly([
          'certificateNumber', 'certificateType', 'studentId', 'studentName',
          'fatherName', 'guardianName', 'className', 'rollNo', 'admissionNo',
          'dob', 'address', 'issueDate', 'remarks', 'academicYear',
          'issuedBy', 'issuedAt', 'issuedAtIso'
        ]);
      allow update, delete: if isAdmin();
    }

    match /school_settings/{documentId} {
      allow get: if hasActiveRole();
      allow list: if false;
      allow create, update, delete: if isAdmin();
    }

    // Public school gallery images are stored in small chunks so each document stays bounded.
    // Login needs public read; only the school administrator may change gallery chunks.
    match /school_gallery/{documentId} {
      allow get, list: if true;
      allow create, update: if isAdmin() &&
        documentId.matches("part_[0-9]{2}") &&
        request.resource.data.keys().hasOnly(['photos', 'updatedAt', 'updatedBy']) &&
        request.resource.data.photos is list &&
        request.resource.data.photos.size() > 0 &&
        request.resource.data.photos.size() <= 4 &&
        request.resource.data.photos[0] is string &&
        request.resource.data.photos[0].size() <= 245760 &&
        (request.resource.data.photos.size() < 2 ||
          (request.resource.data.photos[1] is string && request.resource.data.photos[1].size() <= 245760)) &&
        (request.resource.data.photos.size() < 3 ||
          (request.resource.data.photos[2] is string && request.resource.data.photos[2].size() <= 245760)) &&
        (request.resource.data.photos.size() < 4 ||
          (request.resource.data.photos[3] is string && request.resource.data.photos[3].size() <= 245760));
      allow delete: if isAdmin() && documentId.matches("part_[0-9]{2}");
    }

    // Public login branding only; private school contact details remain protected.
    match /school_public_branding/{documentId} {
      allow get: if documentId == 'main';
      allow list: if false;
      allow create, update, delete: if isAdmin() && documentId == 'main';
    }

    // A user can read their own role record; Admin manages all role records.
    match /user_roles/{userId} {
      allow get: if isAdmin() || isViewer() || (signedIn() && request.auth.uid == userId);
      allow list: if isAdmin() || isViewer();
      allow create, update, delete: if isAdmin();
    }

    // Audit records are append-only. Only active school users may write
    // their own bounded, well-formed activity record. Admin alone may read.
    match /audit_logs/{documentId} {
      allow get, list: if isAdmin() || isViewer();
      allow create: if hasActiveRole() && !isViewer() &&
        request.resource.data.actorUid == request.auth.uid &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.actorName is string &&
        request.resource.data.actorName.size() > 0 &&
        request.resource.data.actorName.size() <= 100 &&
        request.resource.data.module is string &&
        request.resource.data.module.size() > 0 &&
        request.resource.data.module.size() <= 40 &&
        request.resource.data.action is string &&
        request.resource.data.action.size() > 0 &&
        request.resource.data.action.size() <= 40 &&
        request.resource.data.recordId is string &&
        request.resource.data.recordId.size() > 0 &&
        request.resource.data.recordId.size() <= 150 &&
        request.resource.data.detail is string &&
        request.resource.data.detail.size() <= 240 &&
        request.resource.data.keys().hasOnly([
          'actorUid', 'actorName', 'module', 'action',
          'recordId', 'detail', 'createdAt'
        ]);
      allow update, delete: if false;
    }

    // Public result index: contains exam metadata only.
    match /public_result_exams/{examId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    // Public lookup is exact-document get only. Public list is forbidden.
    // Admin list is needed for safe per-student re-publish/unpublish and backup.
    match /public_result_lookup/{lookupId} {
      allow get: if true;
      allow list: if isAdmin() || isViewer();
      allow create, update, delete: if isAdmin();
    }

    // Public result documents can be fetched only by known document ID.
    // Admin list is needed for publication status, legacy cleanup and backup.
    match /public_results/{resultId} {
      allow get: if true;
      allow list: if isAdmin() || isViewer();
      allow create, update, delete: if isAdmin();
    }

    // Reserved collection; no client-side access is enabled.
    match /online_result_rate_limits/{documentId} {
      allow read, write: if false;
    }

    match /cdc_curriculum/{documentId} {
      allow get, list: if hasActiveRole();
      allow create, update, delete: if isAdmin();
    }

    match /cdc_blueprints/{documentId} {
      allow get, list: if hasActiveRole();
      allow create, update, delete: if isAdmin();
    }

    match /question_bank/{questionId} {
      allow get, list: if hasActiveRole() &&
        (isViewer() || isAssignedSubject(
          resource.data.get('className', ''),
          resource.data.get('subject', ''),
          resource.data.get('section', '')
        ));
      allow create: if hasActiveRole() &&
        isAssignedSubject(
          request.resource.data.get('className', ''),
          request.resource.data.get('subject', ''),
          request.resource.data.get('section', '')
        ) &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.gradeNumber is int &&
        request.resource.data.gradeNumber >= 6 &&
        request.resource.data.gradeNumber <= 10 &&
        request.resource.data.className is string &&
        request.resource.data.className.size() > 0 &&
        request.resource.data.subject is string &&
        request.resource.data.subject.size() > 0 &&
        request.resource.data.section is string &&
        request.resource.data.section.size() <= 40 &&
        request.resource.data.questionText is string &&
        request.resource.data.questionText.size() > 0 &&
        request.resource.data.questionText.size() <= 3000 &&
        request.resource.data.questionType in ['mcq', 'short', 'long'] &&
        request.resource.data.marks is number &&
        request.resource.data.marks >= 1 &&
        request.resource.data.marks <= 100 &&
        request.resource.data.cognitiveLevel in ['knowledge', 'understanding', 'application', 'higher'] &&
        request.resource.data.topicId is string &&
        request.resource.data.topicId.size() > 0 &&
        request.resource.data.topicName is string &&
        request.resource.data.topicName.size() > 0 &&
        request.resource.data.options is list &&
        request.resource.data.options.size() <= 4 &&
        request.resource.data.keys().hasOnly([
          'gradeNumber', 'className', 'subject', 'section', 'unitId',
          'unitTitle', 'topicId', 'topicName', 'questionType', 'marks',
          'cognitiveLevel', 'questionText', 'options', 'correctOption',
          'answer', 'createdBy', 'createdByName', 'createdAt', 'status'
        ]);
      allow update: if isAdmin() ||
        (hasActiveRole() &&
         resource.data.createdBy == request.auth.uid &&
         isAssignedSubject(
           resource.data.get('className', ''),
           resource.data.get('subject', ''),
           resource.data.get('section', '')
         ) &&
         request.resource.data.createdBy == request.auth.uid &&
         request.resource.data.className == resource.data.className &&
         request.resource.data.subject == resource.data.subject &&
         request.resource.data.section == resource.data.section);
      allow delete: if isAdmin() ||
        (hasActiveRole() &&
         resource.data.createdBy == request.auth.uid &&
         isAssignedSubject(
           resource.data.get('className', ''),
           resource.data.get('subject', ''),
           resource.data.get('section', '')
         ));
    }

    match /question_papers/{paperId} {
      allow get, list: if isAdmin() || isViewer() ||
        (hasActiveRole() &&
         resource.data.createdBy == request.auth.uid &&
         isAssignedSubject(
           resource.data.get('className', ''),
           resource.data.get('subject', ''),
           resource.data.get('section', '')
         ));
      allow create: if hasActiveRole() &&
        isAssignedSubject(
          request.resource.data.get('className', ''),
          request.resource.data.get('subject', ''),
          request.resource.data.get('section', '')
        ) &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.gradeNumber is int &&
        request.resource.data.gradeNumber >= 6 &&
        request.resource.data.gradeNumber <= 10 &&
        request.resource.data.className is string &&
        request.resource.data.subject is string &&
        request.resource.data.section is string &&
        request.resource.data.paperTitle is string &&
        request.resource.data.paperTitle.size() > 0 &&
        request.resource.data.paperTitle.size() <= 120 &&
        request.resource.data.fullMarks is number &&
        request.resource.data.fullMarks >= 1 &&
        request.resource.data.fullMarks <= 500 &&
        request.resource.data.durationMinutes is int &&
        request.resource.data.durationMinutes >= 15 &&
        request.resource.data.durationMinutes <= 360 &&
        request.resource.data.questions is list &&
        request.resource.data.questions.size() > 0 &&
        request.resource.data.questions.size() <= 80 &&
        request.resource.data.topicIds is list &&
        request.resource.data.topicIds.size() > 0 &&
        request.resource.data.keys().hasOnly([
          'schoolName', 'schoolAddress', 'gradeNumber', 'className',
          'subject', 'section', 'paperTitle', 'academicYear',
          'durationMinutes', 'fullMarks', 'curriculumVersion',
          'blueprintId', 'cognitiveDistribution', 'topicIds', 'questions', 'createdBy',
          'createdAt', 'status'
        ]);
      allow update: if isAdmin();
      allow delete: if isAdmin() ||
        (hasActiveRole() &&
         resource.data.createdBy == request.auth.uid &&
         isAssignedSubject(
           resource.data.get('className', ''),
           resource.data.get('subject', ''),
           resource.data.get('section', '')
         ));
    }

    // Deny all other collections and documents by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
